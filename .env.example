# ── Swiggy MCP ──────────────────────────────────────────────────────────────
# Obtain via OAuth: python scripts/auth.py
# Docs: https://mcp.swiggy.com/builders/docs/start/authenticate.md
SWIGGY_ACCESS_TOKEN=

# ── LLM provider (uncomment exactly one) ────────────────────────────────────
# Priority order: Gemini → Anthropic → OpenAI (first key found wins)
GEMINI_API_KEY=
# ANTIGRAVITY_API_KEY=   # Gemini alias — use this OR GEMINI_API_KEY
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Optional overrides ───────────────────────────────────────────────────────
# LLM_MODEL=                 # e.g. gemini-2.0-flash, claude-3-5-sonnet-latest, gpt-4o
# AGENT_MAX_TURNS=4          # Max LLM↔tool-call iterations per request
# MCP_REQUEST_TIMEOUT=30     # Swiggy MCP HTTP timeout in seconds
# MCP_MAX_RETRIES=4          # Exponential-backoff retry limit
# CART_MAX_CAP_INR=1000      # Hard cap on cart total (₹)
# DEFAULT_ADDRESS_LABEL=Home # Label for fallback address
